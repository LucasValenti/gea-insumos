---
import Marca from "./Marca.astro";

// Mientras no haya fotos, la ficha no se ve rota:
//  - si el producto ES un color, se muestra ese color
//  - si no, se muestra la marca sobre nude claro
// Cuando llegue la foto real, se agrega `foto` al producto y este
// componente la usa sin tocar nada más.
interface Props {
  producto: { nombre: string; color?: string; foto?: string };
  grande?: boolean;
}
const { producto, grande = false } = Astro.props;
const sinFoto = !producto.foto;
---

<div class:list={["foto", { grande }]}>
  {producto.foto ? (
    <img src={`/productos/${producto.foto}`} alt={producto.nombre} loading="lazy" width="600" height="600" />
  ) : producto.color ? (
    <span class="tono" style={`background:${producto.color}`}></span>
  ) : (
    <span class="marca-fondo"><Marca tamano={grande ? "grande" : "chico"} /></span>
  )}

  {sinFoto && <span class="pendiente">Foto pendiente</span>}
</div>

<style>
  .foto {
    aspect-ratio: 1 / 1;
    background: var(--nude-50);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }
  .foto.grande {
    border: 1px solid var(--hairline);
    border-radius: var(--radio);
  }
  .foto img { width: 100%; height: 100%; object-fit: cover; }

  .tono {
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(17, 17, 17, .12);
    box-shadow: inset 0 -8px 18px -8px rgba(0, 0, 0, .35);
  }

  .marca-fondo { color: var(--nude-300); }

  .pendiente {
    position: absolute;
    bottom: .5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: .55rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: .15rem .45rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .grande .pendiente { bottom: 1rem; font-size: .62rem; }
</style>
