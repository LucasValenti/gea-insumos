---
import Marca from "./Marca.astro";
import IconoWhatsapp from "./IconoWhatsapp.astro";
import { enlaceWhatsapp } from "../data/config.js";

interface Props {
  conBuscador?: boolean;
}
const { conBuscador = false } = Astro.props;
---

<header class="encabezado">
  <div class="interior">
    <a href="/" aria-label="GEA Insumos, ir al inicio"><Marca colorInsumos="var(--nude-600)" /></a>

    {conBuscador ? (
      <div class="buscador">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <input type="search" id="buscador" placeholder="Buscar un producto..." aria-label="Buscar un producto" autocomplete="off" />
      </div>
    ) : (
      <a class="volver" href="/catalogo">Ver el catálogo</a>
    )}

    <a class="btn btn-primary" href={enlaceWhatsapp(null)} target="_blank" rel="noopener">
      <IconoWhatsapp />
      <span class="texto-btn">Consultar</span>
    </a>
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--surface);
    border-bottom: 1px solid var(--hairline);
  }
  .interior {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: .85rem 1.25rem;
    max-width: var(--maxw);
    margin: 0 auto;
  }

  .buscador { position: relative; max-width: 30rem; width: 100%; justify-self: center; }
  .buscador input {
    width: 100%;
    font-family: inherit;
    font-size: .95rem;
    padding: .7rem .9rem .7rem 2.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radio);
    background: var(--paper);
    color: var(--ink);
  }
  .buscador input::placeholder { color: var(--ink-faint); }
  .buscador input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px var(--nude-100);
  }
  .buscador svg {
    position: absolute;
    left: .8rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1rem; height: 1rem;
    color: var(--ink-faint);
    pointer-events: none;
  }

  .volver {
    justify-self: center;
    font-size: .74rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 2px;
  }
  .volver:hover { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 600px) {
    .interior { grid-template-columns: auto 1fr; gap: .75rem; }
    .buscador { grid-column: 1 / -1; order: 3; max-width: none; }
    .volver { display: none; }
    .texto-btn { display: none; }
    .btn { padding: .7rem .9rem; }
  }
</style>
