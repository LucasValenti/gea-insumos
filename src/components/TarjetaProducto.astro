---
import FotoProducto from "./FotoProducto.astro";
import { precio } from "../data/config.js";
import { nombreCategoria } from "../data/categorias.js";

interface Props {
  producto: any;
}
const { producto } = Astro.props;
---

<a
  class="tarjeta"
  href={`/producto/${producto.id}`}
  data-nombre={producto.nombre.toLowerCase()}
  data-cat={producto.cat}
>
  <FotoProducto producto={producto} />
  <div class="cuerpo">
    <span class="categoria">{nombreCategoria(producto.cat)}</span>
    <span class="nombre">{producto.nombre}</span>
    <span class="precio">{precio(producto.precio)}</span>
    <span class="btn btn-primary">Consultar</span>
  </div>
</a>

<style>
  .tarjeta {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radio);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }
  .tarjeta:hover {
    border-color: var(--nude-300);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta, .tarjeta:hover { transition: none; transform: none; }
  }

  .cuerpo {
    padding: .85rem .9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: .25rem;
    flex: 1;
  }
  .categoria {
    font-size: .6rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .nombre {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.3;
  }
  .precio {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
    margin-top: auto;
    padding-top: .5rem;
  }
  .btn {
    width: 100%;
    margin-top: .6rem;
    padding: .65rem .8rem;
    font-size: .67rem;
  }

  @media (max-width: 720px) {
    .nombre { font-size: .92rem; }
    .precio { font-size: 1.05rem; }
  }
</style>
