---
import IconoWhatsapp from "./IconoWhatsapp.astro";
import { enlaceWhatsapp } from "../data/config.js";

interface Props {
  producto?: any;
}
const { producto = null } = Astro.props;
---

<a class="flotante" href={enlaceWhatsapp(producto)} target="_blank" rel="noopener" aria-label="Consultar por WhatsApp">
  <IconoWhatsapp />
</a>

<style>
  .flotante {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 999px;
    width: 3.4rem;
    height: 3.4rem;
    display: grid;
    place-items: center;
    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, .45);
  }
  .flotante :global(svg) { width: 1.5rem; height: 1.5rem; }
  .flotante:hover { background: var(--nude-600); }

  @media (min-width: 900px) { .flotante { display: none; } }
</style>
