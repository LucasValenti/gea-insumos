---
import Base from "../../layouts/Base.astro";
import Encabezado from "../../components/Encabezado.astro";
import FotoProducto from "../../components/FotoProducto.astro";
import TarjetaProducto from "../../components/TarjetaProducto.astro";
import IconoWhatsapp from "../../components/IconoWhatsapp.astro";
import Pie from "../../components/Pie.astro";
import BotonFlotante from "../../components/BotonFlotante.astro";
import { PRODUCTOS, porCategoria } from "../../data/productos.js";
import { nombreCategoria } from "../../data/categorias.js";
import { precio, enlaceWhatsapp, NEGOCIO } from "../../data/config.js";

// Una página por producto: /producto/torno-portatil-35000
// Esto es lo que permite que alguien buscando "torno para uñas"
// caiga directo en esta ficha.
export function getStaticPaths() {
  return PRODUCTOS.map((p) => ({
    params: { id: p.id },
    props: { producto: p },
  }));
}

const { producto } = Astro.props;
const cat = nombreCategoria(producto.cat);

const datos = [
  ["Categoría", cat],
  ["Contenido", producto.contenido],
  ["Rendimiento", producto.rinde],
  ["Modo de uso", producto.uso],
].filter(([, v]) => v);

const relacionados = porCategoria(producto.cat)
  .filter((p) => p.id !== producto.id)
  .slice(0, 4);

// Datos estructurados: le dice a Google que esto es un producto
// con precio, y puede mostrarlo directo en los resultados.
const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: producto.nombre,
  description: producto.desc,
  category: cat,
  brand: { "@type": "Brand", name: NEGOCIO.nombre },
  offers: {
    "@type": "Offer",
    price: producto.precio,
    priceCurrency: "ARS",
    availability: "https://schema.org/InStock",
    url: new URL(`/producto/${producto.id}`, Astro.site).href,
  },
};
---

<Base titulo={producto.nombre} descripcion={producto.desc}>
  <Encabezado conBuscador={false} />

  <main class="wrap">
    <nav class="miga" aria-label="Estás acá">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href={`/catalogo/${producto.cat}`}>{cat}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{producto.nombre}</span>
    </nav>

    <div class="ficha">
      <div>
        <FotoProducto producto={producto} grande={true} />
      </div>

      <div class="datos">
        <span class="categoria">{cat}</span>
        <h1>{producto.nombre}</h1>

        <p class="precio">
          {precio(producto.precio)}
          <small>Precio por unidad · consultá por cantidad</small>
        </p>

        <a class="btn btn-primary consultar" href={enlaceWhatsapp(producto)} target="_blank" rel="noopener">
          <IconoWhatsapp />
          Consultar por WhatsApp
        </a>

        {producto.desc && <p class="descripcion">{producto.desc}</p>}

        {datos.length > 0 && (
          <dl class="tabla">
            {datos.map(([k, v]) => (
              <div class="fila">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>

    {relacionados.length > 0 && (
      <section class="relacionados">
        <h2 class="titulo-seccion">Otros de {cat.toLowerCase()}</h2>
        <div class="grid">
          {relacionados.map((p) => <TarjetaProducto producto={p} />)}
        </div>
      </section>
    )}
  </main>

  <Pie />
  <BotonFlotante producto={producto} />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<style>
  main { padding-bottom: 4rem; }

  .miga {
    font-size: .78rem;
    color: var(--ink-faint);
    padding: 1.5rem 0 1.25rem;
    display: flex;
    gap: .4rem;
    flex-wrap: wrap;
  }
  .miga a { color: var(--nude-600); }
  .miga a:hover { text-decoration: underline; }

  .ficha {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 820px) { .ficha { grid-template-columns: 1fr; gap: 1.5rem; } }

  .categoria {
    font-size: .66rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.15;
    margin: .4rem 0 0;
  }
  .precio {
    font-family: var(--serif);
    font-size: 2rem;
    font-variant-numeric: tabular-nums;
    margin: 1.1rem 0 .3rem;
  }
  .precio small {
    font-size: .78rem;
    font-family: var(--sans);
    color: var(--ink-faint);
    display: block;
    letter-spacing: .04em;
  }
  .consultar { width: 100%; margin-top: 1.1rem; padding: 1rem 1.4rem; font-size: .8rem; }
  .descripcion { margin: 1.5rem 0 0; color: var(--ink-soft); font-size: .97rem; }

  .tabla { margin: 1.5rem 0 0; border-top: 1px solid var(--hairline); }
  .fila {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: .65rem 0;
    border-bottom: 1px solid var(--hairline);
    font-size: .9rem;
  }
  dt {
    font-size: .66rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: .2rem;
  }
  dd { margin: 0; color: var(--ink-soft); }
  @media (max-width: 520px) { .fila { grid-template-columns: 1fr; gap: .1rem; } }

  .relacionados { margin-top: 4rem; }
  .relacionados .titulo-seccion { margin-bottom: 1rem; }
</style>
