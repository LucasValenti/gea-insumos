---
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import Pie from "../components/Pie.astro";
---

<Base titulo="Página no encontrada" descripcion="La página que buscabas no existe.">
  <Encabezado conBuscador={false} />

  <main class="wrap">
    <h1>No encontramos esa página</h1>
    <p>Puede que el enlace esté viejo o que el producto ya no esté en el catálogo.</p>
    <div class="acciones">
      <a class="btn btn-primary" href="/catalogo">Ver el catálogo</a>
      <a class="btn btn-ghost" href="/">Ir al inicio</a>
    </div>
  </main>

  <Pie />
</Base>

<style>
  main {
    padding: 5rem 0 6rem;
    max-width: 34rem;
    text-align: center;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    margin: 0;
    line-height: 1.2;
  }
  p { color: var(--ink-soft); margin: .8rem auto 0; }
  .acciones {
    display: flex;
    gap: .75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
