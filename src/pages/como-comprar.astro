---
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import IconoWhatsapp from "../components/IconoWhatsapp.astro";
import Pie from "../components/Pie.astro";
import BotonFlotante from "../components/BotonFlotante.astro";
import { NEGOCIO, enlaceWhatsapp } from "../data/config.js";

const PASOS = [
  {
    titulo: "Elegí lo que necesitás",
    texto: "Buscá el producto por nombre en el catálogo o entrá por categoría. Los precios que ves son por unidad.",
  },
  {
    titulo: "Tocá Consultar",
    texto: "Se abre WhatsApp con el nombre del producto y el precio ya escritos en el mensaje. No tenés que explicar nada.",
  },
  {
    titulo: "Coordinamos por chat",
    texto: "Te confirmamos disponibilidad y armamos el pedido. Si llevás varias unidades, consultá el precio por cantidad.",
  },
  {
    titulo: "Pagás y te lo enviamos",
    texto: "Te pasamos los datos para el pago y despachamos apenas se acredita.",
  },
];
---

<Base
  titulo="Cómo comprar"
  descripcion="Los cuatro pasos para comprar insumos de manicuría en GEA: elegís, consultás por WhatsApp, coordinamos y te lo enviamos."
>
  <Encabezado conBuscador={false} />

  <main class="wrap">
    <h1>Cómo comprar</h1>
    <p class="bajada">No hay carrito ni pagos en línea. Se coordina todo por WhatsApp, así podés preguntar antes de comprar.</p>

    <ol class="pasos">
      {PASOS.map((p) => (
        <li>
          <b>{p.titulo}</b>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>

    <section class="bloques">
      <div class="bloque">
        <h2>Formas de pago</h2>
        {NEGOCIO.formasDePago.length ? (
          <ul>{NEGOCIO.formasDePago.map((f) => <li>{f}</li>)}</ul>
        ) : (
          <p class="pendiente">A confirmar con el negocio.</p>
        )}
      </div>

      <div class="bloque">
        <h2>Envíos</h2>
        {NEGOCIO.envios ? <p>{NEGOCIO.envios}</p> : <p class="pendiente">A confirmar con el negocio.</p>}
      </div>

      <div class="bloque">
        <h2>Retiro</h2>
        {NEGOCIO.direccion ? (
          <p>{NEGOCIO.direccion}{NEGOCIO.horarios && <><br />{NEGOCIO.horarios}</>}</p>
        ) : (
          <p class="pendiente">A confirmar con el negocio.</p>
        )}
      </div>
    </section>

    <a class="btn btn-primary grande" href={enlaceWhatsapp(null)} target="_blank" rel="noopener">
      <IconoWhatsapp />
      Escribinos por WhatsApp
    </a>
  </main>

  <Pie />
  <BotonFlotante />
</Base>

<style>
  main { padding: 2.5rem 0 5rem; max-width: 52rem; }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    margin: 0;
    line-height: 1.15;
  }
  .bajada { color: var(--ink-soft); margin: .6rem 0 0; max-width: 34rem; }

  .pasos {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    counter-reset: paso;
    display: grid;
    gap: 1.25rem;
  }
  .pasos li {
    counter-increment: paso;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
  }
  .pasos li::before {
    content: counter(paso);
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--nude-300);
    line-height: 1.1;
  }
  .pasos b { display: block; font-size: 1.02rem; margin-bottom: .2rem; }
  .pasos p { margin: 0; color: var(--ink-soft); font-size: .94rem; }

  .bloques {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }
  .bloque {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--nude-200);
    border-radius: var(--radio);
    padding: 1.1rem 1.25rem;
  }
  .bloque h2 {
    font-size: .66rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 .6rem;
  }
  .bloque p, .bloque li { font-size: .92rem; color: var(--ink-soft); margin: 0; }
  .bloque ul { list-style: none; padding: 0; display: grid; gap: .25rem; }
  .pendiente { color: var(--nude-600); font-style: italic; }

  .grande { margin-top: 2.5rem; padding: 1rem 1.6rem; font-size: .8rem; }
</style>
