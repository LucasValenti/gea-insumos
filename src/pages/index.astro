---
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import BarraCategorias from "../components/BarraCategorias.astro";
import FranjaMarca from "../components/FranjaMarca.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import ComoComprar from "../components/ComoComprar.astro";
import Pie from "../components/Pie.astro";
import BotonFlotante from "../components/BotonFlotante.astro";
import { CATEGORIAS } from "../data/categorias.js";
import { PRODUCTOS, porCategoria } from "../data/productos.js";
import { NEGOCIO } from "../data/config.js";

// La portada muestra los primeros de cada categoría. Sin imagen
// gigante: en la primera pantalla ya hay producto.
const destacados = PRODUCTOS.slice(0, 8);
---

<Base titulo={NEGOCIO.nombre}>
  <Encabezado conBuscador={false} />
  <BarraCategorias activa="" />
  <FranjaMarca />

  <main class="wrap">
    <div class="listhead">
      <h2 class="titulo-seccion">Lo más pedido</h2>
      <a class="ver-todo" href="/catalogo">Ver los {PRODUCTOS.length} productos</a>
    </div>
    <div class="grid">
      {destacados.map((p) => <TarjetaProducto producto={p} />)}
    </div>

    <section class="categorias">
      <h2 class="titulo-seccion">Por categoría</h2>
      <div class="tarjetas-cat">
        {CATEGORIAS.map((c) => (
          <a class="tcat" href={`/catalogo/${c.id}`}>
            <span class="nombre">{c.nombre}</span>
            <span class="desc">{c.descripcion}</span>
            <span class="cuenta">{porCategoria(c.id).length} productos</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <ComoComprar />
  <Pie />
  <BotonFlotante />
</Base>

<style>
  main { padding-bottom: 4rem; }

  .ver-todo {
    font-size: .74rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--nude-600);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 2px;
  }
  .ver-todo:hover { border-color: var(--nude-600); }

  .categorias { margin-top: 3.5rem; }
  .categorias .titulo-seccion { margin-bottom: 1rem; }

  .tarjetas-cat {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .tcat {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--nude-200);
    border-radius: var(--radio);
    padding: 1.1rem 1.25rem;
    display: grid;
    gap: .3rem;
    transition: border-color .18s ease, box-shadow .18s ease;
  }
  .tcat:hover { border-color: var(--nude-300); box-shadow: var(--shadow); }
  .tcat .nombre { font-family: var(--serif); font-size: 1.15rem; }
  .tcat .desc { font-size: .87rem; color: var(--ink-soft); }
  .tcat .cuenta {
    font-size: .66rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: .25rem;
  }
</style>
