---
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import IconoWhatsapp from "../components/IconoWhatsapp.astro";
import Pie from "../components/Pie.astro";
import BotonFlotante from "../components/BotonFlotante.astro";
import { NEGOCIO, enlaceWhatsapp } from "../data/config.js";
---

<Base
  titulo="Contacto"
  descripcion="Escribinos por WhatsApp o seguinos en Instagram. Respondemos consultas sobre productos, precios y envíos."
>
  <Encabezado conBuscador={false} />

  <main class="wrap">
    <h1>Contacto</h1>
    <p class="bajada">La forma más rápida es WhatsApp. Respondemos consultas de productos, precios por cantidad y envíos.</p>

    <div class="canales">
      <a class="canal" href={enlaceWhatsapp(null)} target="_blank" rel="noopener">
        <IconoWhatsapp />
        <span class="que">WhatsApp</span>
        <span class="detalle">Consultas y pedidos</span>
      </a>

      <a class="canal" href={NEGOCIO.instagram} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="3.8" />
          <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
        </svg>
        <span class="que">Instagram</span>
        <span class="detalle">{NEGOCIO.instagramUsuario}</span>
      </a>
    </div>

    <dl class="tabla">
      <div class="fila">
        <dt>Ciudad</dt>
        <dd>{NEGOCIO.ciudad ?? <span class="pendiente">A confirmar</span>}</dd>
      </div>
      <div class="fila">
        <dt>Local</dt>
        <dd>{NEGOCIO.direccion ?? <span class="pendiente">A confirmar</span>}</dd>
      </div>
      <div class="fila">
        <dt>Horarios</dt>
        <dd>{NEGOCIO.horarios ?? <span class="pendiente">A confirmar</span>}</dd>
      </div>
    </dl>
  </main>

  <Pie />
  <BotonFlotante />
</Base>

<style>
  main { padding: 2.5rem 0 5rem; max-width: 48rem; }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    margin: 0;
    line-height: 1.15;
  }
  .bajada { color: var(--ink-soft); margin: .6rem 0 0; max-width: 32rem; }

  .canales {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .canal {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radio);
    padding: 1.4rem 1.35rem;
    display: grid;
    gap: .2rem;
    transition: border-color .18s ease, box-shadow .18s ease;
  }
  .canal:hover { border-color: var(--nude-300); box-shadow: var(--shadow); }
  .canal :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--nude-600); margin-bottom: .5rem; }
  .que { font-family: var(--serif); font-size: 1.2rem; }
  .detalle { font-size: .87rem; color: var(--ink-soft); }

  .tabla { margin: 3rem 0 0; border-top: 1px solid var(--hairline); }
  .fila {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: .75rem 0;
    border-bottom: 1px solid var(--hairline);
    font-size: .93rem;
  }
  dt {
    font-size: .66rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: .2rem;
  }
  dd { margin: 0; color: var(--ink-soft); }
  .pendiente { color: var(--nude-600); font-style: italic; }
  @media (max-width: 520px) { .fila { grid-template-columns: 1fr; gap: .1rem; } }
</style>
